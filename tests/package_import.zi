#import "webp/facade"
#import "std/file"
#import "std/vec"
#import "std/image"
#import "std/byte_text_linux"
#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    if argc != 2 { return 2 }
    bytes: Vec(u8)
    if !ReadFileInto(TextFromCString(argv[1]), *bytes) { return 3 }
    result := WebpDecode(BorrowBytes(VecSlice(bytes, 0, bytes.count)), WebpDefaultOptions())
    return ifx result.is_ok && ImageValid(*result.image) && result.image.width == 3 && result.image.height == 2 then 0 else 4
}
