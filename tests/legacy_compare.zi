#import "webp/facade"
Legacy :: #import "legacy_backend/webp_image"
#import "std/vec"
#import "std/image"
#import "std/file"
#import "std/byte_text_linux"
#import "std/stdio_linux"
native :: #system_library "imagewebp";
ReleaseLegacy :: (pixels: *u8) #foreign native "WebPFree";

Compare :: (path: string) -> bool {
    bytes: Vec(u8)
    if !ReadFileInto(path, *bytes) { return false }
    data := VecSlice(bytes, 0, bytes.count)
    current := WebpDecode(BorrowBytes(data), WebpDefaultOptions())
    if !current.is_ok { return false }
    width: s32; height: s32
    legacy := Legacy.WebPImageDecode(TextView(data), *width, *height)
    if legacy == null { return false }
    same := width == current.image.width && height == current.image.height
    if same {
        for i: 0..current.image.pixels.count - 1 { if legacy[i] != current.image.pixels[i] { same = false; break } }
    }
    ReleaseLegacy(legacy)
    return same
}
#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    if argc != 2 { return 2 }
    root := TextFromCString(argv[1])
    names: [4]string = .["lossy.webp", "lossless.webp", "lossy-alpha.webp", "animated.webp"]
    for name: names {
        path: Vec(u8)
        unused BuilderAppend(path, root); unused BuilderAppend(path, "/webp/"); unused BuilderAppend(path, name)
        if !Compare(BuilderFinish(path)) { unused PrintError(name); unused PrintError(" differs from current Kryon WebP pixels\n"); return 1 }
    }
    return 0
}
